{
  "manifest_version": 3,
  "name": "Deepfake Signal MVP",
  "description": "Find visible video and image candidates in the active tab.",
  "version": "0.2.1",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Deepfake Signal"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://youtube.com/*",
        "https://www.youtube.com/*"
      ],
      "js": [
        "youtube_demo.js"
      ],
      "css": [
        "youtube_demo.css"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "demo/233037_medium.mp4",
        "demo/233037_thumbnail.jpg"
      ],
      "matches": [
        "https://youtube.com/*",
        "https://www.youtube.com/*"
      ]
    }
  ]
}
