{
  "manifest_version": 3,
  "name": "Deepfake Signal MVP",
  "description": "Find visible video and image candidates in the active tab.",
  "version": "0.1.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Deepfake Signal"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ]
}
